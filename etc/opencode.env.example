# Example environment for the opencode systemd service.
# The installer writes the real file to /etc/opencode/env (root:root 0600).
#
# Only OPENCODE_PASSWORD is required. Provider credentials normally live in
# `opencode auth login` state under the service user's home; add keys here only
# if you cannot run the interactive login on this host.

OPENCODE_PASSWORD=replace-with-32-chars

# Optional provider keys, uncomment as needed:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional: raise log verbosity while debugging.
# OPENCODE_LOG_LEVEL=debug
